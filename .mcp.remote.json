// Remote MCP configuration — http mode
// Usage:
//   1. Copy this file to .mcp.json to switch to remote mode
//   2. Set MCP_TRANSPORT=http on the remote host
//   3. Set MCP_BASE_URL to the Django API URL on the remote host
//   4. Replace <tailscale-ip-or-host> with the actual Tailscale IP of the Pi or remote host
{
  "mcpServers": {
    "otomais": {
      "type": "http",
      "url": "http://<tailscale-ip-or-host>:8001/mcp"
    }
  }
}
