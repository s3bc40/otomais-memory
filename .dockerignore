# uv builds a platform-specific venv inside the image; the host one must never leak in
.venv

# Bytecode is platform/interpreter-specific; Python regenerates it on first import
__pycache__
*.py[oc]

# Dev database — lives in the bind-mounted volume at runtime, not baked into the image
db.sqlite3
*.sqlite3

# Secrets — injected at runtime via env_file, never baked into the image
.env
.env.local

# Version history — no place in a runtime image, and it's large
.git

# CI workflows — irrelevant inside the container
.github

# Local AI assistant config — developer tooling only
.claude

# Generated by collectstatic at container startup, not a build-time input
staticfiles
